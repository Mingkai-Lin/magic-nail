# Copy this file to `.env` and fill in real values.
# Create React App only exposes variables prefixed with REACT_APP_ to the browser bundle,
# and any change here requires restarting `npm start` to take effect.

# Public site info, usable in components as process.env.REACT_APP_SITE_NAME etc.
REACT_APP_SITE_NAME="The Nail Boutique"
REACT_APP_CONTACT_EMAIL=hello@example.com
REACT_APP_CONTACT_PHONE=+2340000000000

# Social links
REACT_APP_INSTAGRAM_URL=
REACT_APP_FACEBOOK_URL=

# Google Maps embed (for a future "Visit us" map on About/Contact)
REACT_APP_GOOGLE_MAPS_API_KEY=

# Contact form delivery via EmailJS (https://www.emailjs.com) - the Contact Us
# form is already wired up to these three; without them it shows an error
# instead of silently pretending to send. To fill them in:
#   1. Create a free EmailJS account and an Email Service -> that's REACT_APP_EMAILJS_SERVICE_ID
#   2. Create an Email Template whose body uses {{name}} {{email}} {{phone}} {{subject}} {{message}}
#      (these match the <input name="..."> fields on the form) -> REACT_APP_EMAILJS_TEMPLATE_ID
#   3. IMPORTANT - this is the part that actually decides where the email lands:
#      in that same Template's settings, find the "To Email" field and set it to
#      {{to_email}} (the form sends this hidden field, filled from REACT_APP_CONTACT_EMAIL
#      below) - or just type your address there directly. Skipping this step is the
#      #1 reason a working EmailJS setup still never reaches your inbox.
#   4. Account -> General -> "Public Key" -> REACT_APP_EMAILJS_PUBLIC_KEY
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# Optional: also deliver the contact form as a text message, via your carrier's
# free email-to-SMS gateway (no extra service needed - EmailJS just emails this
# address too, alongside REACT_APP_CONTACT_EMAIL above). US/Canada numbers only,
# and the carrier truncates the message to ~160 characters. Format is
# <10-digit-number>@<carrier-gateway>, e.g.:
#   AT&T:      1234567890@txt.att.net
#   Verizon:   1234567890@vtext.com
#   T-Mobile:  1234567890@tmomail.net
#   Sprint:    1234567890@messaging.sprintpcs.com
REACT_APP_SMS_GATEWAY_EMAIL=

# Backend / API base URL, once bookings talk to a real server
REACT_APP_API_BASE_URL=http://localhost:4000
